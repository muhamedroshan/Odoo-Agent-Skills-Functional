# Odoo instance
ODOO_URL=https://your-odoo.example.com
ODOO_DB=demo_client
ODOO_USER=admin
# Prefer an API key (Preferences > Account Security > New API Key). Required for Odoo 19 JSON-2.
ODOO_API_KEY=
# ODOO_PASSWORD=           # fallback for XML-RPC if no API key
# Only needed if the agent must create the database (ask the user first)
ODOO_MASTER_PWD=
# Where logs/actions.jsonl is written
ODOO_CLIENT_DIR=clients/demo_client
# ODOO_FORCE_XMLRPC=1     # force XML-RPC on Odoo 19
